{
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "module": "CommonJS",
        "target": "ESNext",
        "skipLibCheck": true,
        "downlevelIteration": true,
        "noImplicitAny": true
    },
    "exclude": [
        "node_modules"
    ],
    "watchOptions": {
        "watchFile": "useFsEvents",
        "watchDirectory": "useFsEvents",
        "fallbackPolling": "dynamicPriority",
        "synchronousWatchDirectory": true,
        "excludeDirectories": [
            "**/node_modules",
            "_build"
        ],
        "excludeFiles": [
            "build/fileWhichChangesOften.ts"
        ]
    }
}